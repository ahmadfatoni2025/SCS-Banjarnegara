            }
            $riwayat_pembelian[] = [ 
                'id' => $pesanan['id_pesanan'], 
                'tanggal' => date('d F Y H:i', strtotime($pesanan['tgl_pesan'])), 
                'status_pembayaran' => $pesanan['status_pembayaran'], 
                'status_pengiriman' => $pesanan['status_pengiriman'], 
                'total_harga' => filter_var($pesanan['total_harga'], FILTER_VALIDATE_FLOAT) ?: 0, 
                'nama_dapur' => $nama_dapur, 
                'nama_driver' => $nama_driver,
                'wa_pemesan' => $pesanan['wa_pemesan'] 
            ];
        }
    } 
    $stmt_pesanan->close();
} else {
     error_log("Gagal prepare query pesanan utama: " . $koneksi->error);
     $feedback_message = "Gagal memuat data riwayat pesanan (prepare)."; 
     $feedback_type = 'error';
}
