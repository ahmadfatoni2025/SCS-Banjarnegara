        $laporan_harian[] = ['nama' => $nama, 'status' => 'Sudah'];
    } else {
        $laporan_harian[] = ['nama' => $nama, 'status' => 'Belum'];
    }
}
// --- AKHIR LOGIKA LAPORAN HARIAN ---


// --- LOGIKA PENGAMBILAN DATA RIWAYAT ---
$riwayat_pembelian = [];
$sql_pesanan = "SELECT id_pesanan, id_dapur, id_driver, nama_pemesan, email_pemesan, wa_pemesan, total_harga, status_pembayaran, status_pengiriman, tgl_pesan, nama_driver FROM pesanan";
$where_conditions = [];
$params = [];
$types = "";
if (!empty($filter_tanggal)) {
    $where_conditions[] = "DATE(tgl_pesan) = ?";
    $params[] = $filter_tanggal;
    $types .= "s";
}
if ($filter_bayar !== 'Semua') {
    $where_conditions[] = "status_pembayaran = ?";
    $params[] = $filter_bayar;
    $types .= "s";
}
if ($filter_kirim !== 'Semua') {
    $where_conditions[] = "status_pengiriman = ?";
    $params[] = $filter_kirim;
    $types .= "s";
}
if (!empty($search)) {
    if (ctype_digit($search)) {
         $where_conditions[] = "(id_pesanan = ? OR nama_pemesan LIKE ? OR nama_driver LIKE ?)"; 
         $search_param_like = "%" . $search . "%";
         $params[] = $search; 
         $params[] = $search_param_like;
         $params[] = $search_param_like; 
         $types .= "iss"; 
    } else {
         $where_conditions[] = "(nama_pemesan LIKE ? OR nama_driver LIKE ?)"; 
         $search_param_like = "%" . $search . "%";
         $params[] = $search_param_like;
         $params[] = $search_param_like; 
         $types .= "ss"; 
    }
}
if (!empty($where_conditions)) {
    $sql_pesanan .= " WHERE " . implode(' AND ', $where_conditions);
}
$order_by = " ORDER BY tgl_pesan DESC"; 
$sql_pesanan .= $order_by;

// --- Eksekusi query ---
