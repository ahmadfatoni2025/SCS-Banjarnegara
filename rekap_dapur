        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const toggleBtn = document.getElementById('toggleLaporanBtn');
                const submenu = document.getElementById('submenuLaporan');
                const icon = document.getElementById('toggleLaporanIcon');
            
                if (toggleBtn && submenu && icon) {
                    
                    let isOpen = !submenu.classList.contains('hidden');
                    
                    if (isOpen) {
                        icon.classList.add('rotate-180');
                    } else {
                        icon.classList.remove('rotate-180');
                    }

                    toggleBtn.addEventListener('click', (e) => {
                        e.preventDefault(); 
                        
                        isOpen = !isOpen; 
            
                        if (isOpen) {
                            submenu.classList.remove('hidden');
                            setTimeout(() => {
                                submenu.style.maxHeight = submenu.scrollHeight + 'px';
                                submenu.style.opacity = '1';
                                icon.classList.add('rotate-180');
                            }, 10);
                        } else {
                            submenu.style.maxHeight = '0';
                            submenu.style.opacity = '0';
                            icon.classList.remove('rotate-180');
                            setTimeout(() => {
                                submenu.classList.add('hidden');
                            }, 500); // Durasi transisi
                        }
                    });
                }
            });
        </script>
