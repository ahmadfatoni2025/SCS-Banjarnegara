// --- KEAMANAN LAPORAN (Admin) ---
if (!isset($_SESSION['role']) || $_SESSION['role'] !== 'admin') {
    header('Location: login.php'); exit();
}
if(isset($_GET['feedback'])) { $feedback_message = htmlspecialchars($_GET['feedback']); $feedback_type = $_GET['type'] ?? 'info'; }

// --- Ambil nilai filter ---
$search = trim($_GET['search'] ?? '');
$filter_tanggal = $_GET['tanggal'] ?? ''; 
$filter_bayar = $_GET['bayar'] ?? 'Semua';
$filter_kirim = $_GET['kirim'] ?? 'Semua';

// --- LOGIKA LAPORAN HARIAN ---
$master_dapur = [];
$dapur_sudah_pesan_ids = [];
$laporan_harian = [];
$stmt_dapur_all = $koneksi->prepare("SELECT id, nama FROM user WHERE role = 'dapur' ORDER BY nama ASC");
if ($stmt_dapur_all) {
    $stmt_dapur_all->execute();
    $stmt_dapur_all->store_result();
    $stmt_dapur_all->bind_result($dapur_id, $dapur_nama);
    while ($stmt_dapur_all->fetch()) {
        $master_dapur[$dapur_id] = $dapur_nama; 
    }
    $stmt_dapur_all->free_result();
    $stmt_dapur_all->close();
}
$stmt_pesan_today = $koneksi->prepare("SELECT DISTINCT id_dapur FROM pesanan WHERE DATE(tgl_pesan) = CURDATE()");
if ($stmt_pesan_today) {
    $stmt_pesan_today->execute();
    $stmt_pesan_today->store_result();
    $stmt_pesan_today->bind_result($id_dapur_pesan);
    while ($stmt_pesan_today->fetch()) {
