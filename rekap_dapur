        </div>
    </main>
    
    <div id="detail-modal-overlay" class="modal-overlay p-4 hidden">
        <div class="bg-white p-6 rounded-xl shadow-2xl w-full max-w-3xl h-5/6 flex flex-col">
            <div class="flex justify-between items-center border-b pb-3 mb-4">
                <h2 class="text-xl font-bold text-gray-800">Detail Pesanan</h2>
                <button id="detail-modal-close" class="text-3xl font-light text-gray-500 hover:text-gray-800">&times;</button>
            </div>
            <iframe id="detail-modal-iframe" src="" class="w-full h-full border-0"></iframe>
        </div>
    </div>

    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Script untuk filter (Tidak Berubah)
            const params = new URLSearchParams(window.location.search);
            if (params.has('search')) {
                const searchInput = document.getElementById('searchLaporan');
                if(searchInput) searchInput.value = params.get('search');
            }
            const tanggalInput = document.getElementById('filterTanggal');
            if (params.has('tanggal') && params.get('tanggal') !== '') {
                if(tanggalInput) tanggalInput.value = params.get('tanggal');
            } else {
                if(tanggalInput) tanggalInput.value = '';
            }
            if (params.has('bayar')) {
                const bayarSelect = document.getElementById('filterBayar');
                if(bayarSelect) bayarSelect.value = params.get('bayar');
            }
            if (params.has('kirim')) {
                const kirimSelect = document.getElementById('filterKirim');
                if(kirimSelect) kirimSelect.value = params.get('kirim');
            }
            
            // JAVASCRIPT UNTUK MODAL DETAIL (Tidak berubah)
            const modalOverlay = document.getElementById('detail-modal-overlay');
            const modalIframe = document.getElementById('detail-modal-iframe');
            const modalCloseBtn = document.getElementById('detail-modal-close');

            if (modalOverlay && modalIframe && modalCloseBtn) {
                
                document.querySelectorAll('.btn-detail-modal').forEach(button => {
                    button.addEventListener('click', function(event) {
                        event.preventDefault(); 
                        const url = this.getAttribute('href');
                        modalIframe.setAttribute('src', url); 
                        modalOverlay.classList.remove('hidden'); 
                    });
                });

                modalCloseBtn.addEventListener('click', function() {
                    modalOverlay.classList.add('hidden'); 
                    modalIframe.setAttribute('src', ''); 
                });
                
                modalOverlay.addEventListener('click', function(event) {
                    if (event.target === modalOverlay) {
                        modalOverlay.classList.add('hidden');
                        modalIframe.setAttribute('src', '');
                    }
                });
            }
        });
    </script>

</body>
</html>