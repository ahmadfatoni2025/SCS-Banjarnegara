$feedback_type = ''; // 'success' atau 'error' atau 'info'

// =========================================================================
// === BLOK PENYIMPANAN PESANAN (TIDAK BERUBAH) ===
// =========================================================================
if (isset($_GET['action']) && $_GET['action'] === 'simpan') {
    
    header('Content-Type: application/json'); 
    $response = ['success' => false, 'message' => 'Terjadi kesalahan tidak diketahui.']; 

    if (!isset($_SESSION['role']) || $_SESSION['role'] !== 'dapur' || !isset($_SESSION['user']['id'])) { 
        $response['message'] = 'Akses ditolak (simpan). Hanya Dapur.'; http_response_code(403); echo json_encode($response); exit;
    }
    $id_dapur = (int)$_SESSION['user']['id']; 

    $input = file_get_contents('php://input');
    $data = json_decode($input, true);

    if ($data === null || !isset($data['cart']) || !isset($data['customerData']) || empty($data['cart'])) {
         $response['message'] = 'Data pesanan tidak valid/kosong.'; http_response_code(400); echo json_encode($response); exit;
    }
    $cart = $data['cart'];
    $customerData = $data['customerData'];
    $nama_pemesan = trim($customerData['nama'] ?? '');
    $email_pemesan = trim($customerData['email'] ?? ''); 
    $wa_pemesan = trim($customerData['wa'] ?? '');
    if (empty($nama_pemesan) || empty($wa_pemesan)) { http_response_code(400); $response['message'] = 'Nama & WA wajib.'; echo json_encode($response); exit; }
    if (!preg_match('/^\d{6,}$/', $wa_pemesan)) { http_response_code(400); $response['message'] = 'No WA invalid.'; echo json_encode($response); exit; }
    if (!empty($email_pemesan) && !filter_var($email_pemesan, FILTER_VALIDATE_EMAIL)) { http_response_code(400); $response['message'] = 'Email invalid.'; echo json_encode($response); exit; }

    $total_harga_server = 0;
    $item_ids = array_map('intval', array_keys($cart)); 
    if (empty($item_ids)) { http_response_code(400); $response['message'] = 'Keranjang kosong.'; echo json_encode($response); exit; }
    
    $placeholders = implode(',', array_fill(0, count($item_ids), '?')); 
    $types = str_repeat('i', count($item_ids)); 
    $sql_harga = "SELECT id_barang, nama, harga, stok FROM gudang WHERE id_barang IN ($placeholders)";
    $stmt_harga = $koneksi->prepare($sql_harga);
    if ($stmt_harga === false) { http_response_code(500); $response['message'] = "DB Error (prepare harga)"; error_log("Gagal prepare harga: " . $koneksi->error); echo json_encode($response); exit; }
    if (!empty($item_ids)) $stmt_harga->bind_param($types, ...$item_ids);
    if (!$stmt_harga->execute()){ http_response_code(500); $response['message'] = "DB Error (exec harga)"; error_log("Gagal exec harga: " . $stmt_harga->error); echo json_encode($response); exit; }
    
    $stmt_harga->store_result();
    $stmt_harga->bind_result($id_barang_db, $nama_db, $harga_db, $stok_db);
    
    $db_items = [];
    while ($stmt_harga->fetch()) {
        $db_items[$id_barang_db] = ['nama' => $nama_db, 'harga' => (float)$harga_db, 'stok' => (int)$stok_db];
    }
    $stmt_harga->free_result();
    $stmt_harga->close();

    $valid_cart_items = []; 
    foreach ($cart as $id_str => $item_cart) {
        $id_barang = (int)$id_str; $jumlah_pesan = filter_var($item_cart['jumlah'] ?? 0, FILTER_VALIDATE_INT); $harga_cart = filter_var($item_cart['harga'] ?? -1, FILTER_VALIDATE_FLOAT); $nama_cart = $item_cart['nama'] ?? '???';
        if ($jumlah_pesan === false || $harga_cart === false) { http_response_code(400); $response['message']="Data jumlah/harga invalid u/ '{$nama_cart}'"; echo json_encode($response); exit;}
        if (!isset($db_items[$id_barang])) { http_response_code(400); $response['message']="Barang '{$nama_cart}' tdk ditemukan"; echo json_encode($response); exit;}
        $item_db = $db_items[$id_barang]; if ($jumlah_pesan <= 0) continue; 
        if (abs($item_db['harga'] - $harga_cart) > 0.01) { http_response_code(400); $response['message']="Harga '{$item_db['nama']}' berubah. Harga skrg: Rp ".number_format($item_db['harga'],0,',','.'); echo json_encode($response); exit;}
        if ($jumlah_pesan > $item_db['stok']) { http_response_code(400); $response['message']="Stok '{$item_db['nama']}' tdk cukup (sisa {$item_db['stok']})"; echo json_encode($response); exit;}
        $total_harga_server += $item_db['harga'] * $jumlah_pesan; $valid_cart_items[$id_barang] = $jumlah_pesan; 
    }
    if (empty($valid_cart_items)) { http_response_code(400); $response['message']='Tdk ada item valid di keranjang'; echo json_encode($response); exit; }

    $koneksi->begin_transaction();
    try {
        $sql_insert_pesanan = "INSERT INTO pesanan (id_dapur, nama_pemesan, email_pemesan, wa_pemesan, total_harga, status_pembayaran, status_pengiriman, tgl_pesan) VALUES (?, ?, ?, ?, ?, 'Belum Bayar', 'Pending', NOW())";
        $stmt_pesanan = $koneksi->prepare($sql_insert_pesanan);
        if ($stmt_pesanan === false) throw new Exception("Gagal prepare insert pesanan: " . $koneksi->error);
        $email_to_insert = !empty($email_pemesan) ? $email_pemesan : null; 
        $stmt_pesanan->bind_param("isssd", $id_dapur, $nama_pemesan, $email_to_insert, $wa_pemesan, $total_harga_server);
        if (!$stmt_pesanan->execute()) throw new Exception("Gagal execute insert pesanan: " . $stmt_pesanan->error . " | Data: ID Dapur={$id_dapur}, Nama={$nama_pemesan}, Email={$email_to_insert}, WA={$wa_pemesan}, Total={$total_harga_server}");
        $id_pesanan_baru = $koneksi->insert_id;
        if ($id_pesanan_baru == 0) throw new Exception("Gagal mendapatkan ID pesanan baru setelah insert.");
        $stmt_pesanan->close();

        $sql_insert_detail = "INSERT INTO detail_pesanan (id_pesanan, id_barang, jumlah, harga_satuan) VALUES (?, ?, ?, ?)";
        $stmt_detail = $koneksi->prepare($sql_insert_detail); if ($stmt_detail === false) throw new Exception("Gagal prepare insert detail: " . $koneksi->error);
        $sql_update_stok = "UPDATE gudang SET stok = GREATEST(0, stok - ?) WHERE id_barang = ? AND stok >= ?";
        $stmt_stok = $koneksi->prepare($sql_update_stok); if ($stmt_stok === false) throw new Exception("Gagal prepare update stok: " . $koneksi->error);
        foreach ($valid_cart_items as $id_barang => $jumlah_pesan) {
            $harga_satuan = $db_items[$id_barang]['harga']; $stmt_detail->bind_param("iiid", $id_pesanan_baru, $id_barang, $jumlah_pesan, $harga_satuan);
            if (!$stmt_detail->execute()) throw new Exception("Gagal execute insert detail u/ ID $id_barang: " . $stmt_detail->error);
            $stmt_stok->bind_param("iii", $jumlah_pesan, $id_barang, $jumlah_pesan); 
            if (!$stmt_stok->execute()) throw new Exception("Gagal execute update stok u/ ID $id_barang: " . $stmt_stok->error);
            if ($stmt_stok->affected_rows === 0) { $nama_brg = $db_items[$id_barang]['nama'] ?? "ID $id_barang"; throw new Exception("Update stok gagal u/ '{$nama_brg}'. Stok mungkin habis.");}
        }
        $stmt_detail->close(); $stmt_stok->close();

        if (!$koneksi->commit()) throw new Exception("Gagal commit transaksi: " . $koneksi->error);
        $response['success'] = true; $response['message'] = "Pesanan berhasil disimpan (ID: $id_pesanan_baru)"; $response['order_id'] = $id_pesanan_baru; 
    } catch (Exception $e) {
        $koneksi->rollback(); $response['message'] = $e->getMessage(); http_response_code(500); error_log("Rollback Triggered (Simpan Pesanan): " . $e->getMessage()); 
    }
    echo json_encode($response); exit;
} 
// =========================================================================
// === BLOK UPDATE STATUS PENGIRIMAN (TIDAK BERUBAH) ===
// =========================================================================
else if (isset($_GET['action']) && $_GET['action'] === 'update_status' && isset($_GET['id']) && isset($_GET['status'])) {
    
    if (!isset($_SESSION['role']) || $_SESSION['role'] !== 'admin') {
        header('Location: login.php?error=unauthorized'); exit;
    }
    $id_pesanan_to_update = filter_var($_GET['id'], FILTER_VALIDATE_INT);
    $new_status = $_GET['status']; 
    $allowed_statuses = ['Pending', 'Ongoing', 'Done']; 

    if ($id_pesanan_to_update && in_array($new_status, $allowed_statuses)) {
        $sql_update = "UPDATE pesanan SET status_pengiriman = ? WHERE id_pesanan = ?";
        $stmt_update = $koneksi->prepare($sql_update);
        if ($stmt_update) {
            $stmt_update->bind_param("si", $new_status, $id_pesanan_to_update);
            if ($stmt_update->execute()) {
                if ($stmt_update->affected_rows > 0) {
                    $feedback_message = "Status pengiriman pesanan #{$id_pesanan_to_update} diubah menjadi '{$new_status}'."; $feedback_type = 'success';
                } else {
                     $feedback_message = "Status pengiriman pesanan #{$id_pesanan_to_update} sudah '{$new_status}' atau ID tidak ditemukan."; $feedback_type = 'info'; 
                }
            } else {
                $feedback_message = "Gagal mengubah status pengiriman: " . $stmt_update->error; $feedback_type = 'error'; error_log($feedback_message);
            }
            $stmt_update->close();
        } else {
             $feedback_message = "Gagal prepare query update pengiriman: " . $koneksi->error; $feedback_type = 'error'; error_log($feedback_message);
        }
    } else {
        $feedback_message = "Permintaan update status pengiriman tidak valid."; $feedback_type = 'error';
    }
    
    $filter_params = http_build_query([
        'search' => $_GET['search'] ?? '',
        'tanggal' => $_GET['tanggal'] ?? '', 
        'bayar' => $_GET['bayar'] ?? 'Semua',
        'kirim' => $_GET['kirim'] ?? 'Semua'
    ]);
    header("Location: laporanPenjualan.php?feedback=" . urlencode($feedback_message) . "&type=" . $feedback_type . "&" . $filter_params); exit;
}
// =========================================================================
// === BLOK UPDATE STATUS PEMBAYARAN (TIDAK BERUBAH) ===
// =========================================================================
else if (isset($_GET['action']) && $_GET['action'] === 'update_bayar' && isset($_GET['id']) && isset($_GET['status'])) {
    
    if (!isset($_SESSION['role']) || $_SESSION['role'] !== 'admin') {
        header('Location: login.php?error=unauthorized'); exit;
    }
    $id_pesanan_to_update = filter_var($_GET['id'], FILTER_VALIDATE_INT);
    $new_status_bayar = $_GET['status']; 
    $allowed_bayar_statuses = ['Belum Bayar', 'Lunas', 'Batal']; 

    if ($id_pesanan_to_update && in_array($new_status_bayar, $allowed_bayar_statuses)) {
        
        $do_rollback = false;
        if ($new_status_bayar === 'Batal') {
            $stmt_check_batal = $koneksi->prepare("SELECT status_pembayaran FROM pesanan WHERE id_pesanan = ?");
            if($stmt_check_batal){
                $stmt_check_batal->bind_param("i", $id_pesanan_to_update);
                $stmt_check_batal->execute();
                $stmt_check_batal->store_result();
                $stmt_check_batal->bind_result($status_sebelumnya);
                if($stmt_check_batal->fetch()){
                    if($status_sebelumnya !== 'Batal'){
                        $do_rollback = true;
                    }
                }
                $stmt_check_batal->free_result();
                $stmt_check_batal->close();
            }
        }

        $koneksi->begin_transaction();
        try {
            $sql_update_bayar = "UPDATE pesanan SET status_pembayaran = ? WHERE id_pesanan = ?";
            $stmt_update_bayar = $koneksi->prepare($sql_update_bayar);
            if (!$stmt_update_bayar) throw new Exception("Gagal prepare update bayar: " . $koneksi->error);
            $stmt_update_bayar->bind_param("si", $new_status_bayar, $id_pesanan_to_update);
            if (!$stmt_update_bayar->execute()) throw new Exception("Gagal execute update bayar: " . $stmt_update_bayar->error);
            $affected_rows_bayar = $stmt_update_bayar->affected_rows;
            $stmt_update_bayar->close();

            if ($do_rollback) {
                $stmt_get_details = $koneksi->prepare("SELECT id_barang, jumlah FROM detail_pesanan WHERE id_pesanan = ?");
                 if (!$stmt_get_details) throw new Exception("Gagal prepare get details for rollback: " . $koneksi->error);
                $stmt_get_details->bind_param("i", $id_pesanan_to_update);
                if (!$stmt_get_details->execute()) throw new Exception("Gagal execute get details for rollback: " . $stmt_get_details->error);
                $items_to_rollback = [];
                $stmt_get_details->store_result();
                $stmt_get_details->bind_result($id_brg_db, $jumlah_db);
                while($stmt_get_details->fetch()){
                    $items_to_rollback[$id_brg_db] = $jumlah_db;
                }
                $stmt_get_details->free_result();
                $stmt_get_details->close();

                if (!empty($items_to_rollback)) {
                    $sql_rollback_stok = "UPDATE gudang SET stok = stok + ? WHERE id_barang = ?";
                    $stmt_rollback = $koneksi->prepare($sql_rollback_stok);
                     if (!$stmt_rollback) throw new Exception("Gagal prepare rollback stok: " . $koneksi->error);
                    foreach ($items_to_rollback as $id_brg => $jml) {
                        $stmt_rollback->bind_param("ii", $jml, $id_brg);
                        if (!$stmt_rollback->execute()) {
                            error_log("Gagal rollback stok untuk barang ID {$id_brg}: " . $stmt_rollback->error);
                        }
                    }
                    $stmt_rollback->close();
                }
            }

            if (!$koneksi->commit()) throw new Exception("Gagal commit transaksi update bayar: " . $koneksi->error);

            if ($affected_rows_bayar > 0) {
                $feedback_message = "Status pembayaran pesanan #{$id_pesanan_to_update} berhasil diubah menjadi '{$new_status_bayar}'.";
                if ($do_rollback) $feedback_message .= " Stok barang telah dikembalikan.";
                $feedback_type = 'success';
            } else {
                 $feedback_message = "Status pembayaran pesanan #{$id_pesanan_to_update} sudah '{$new_status_bayar}' atau ID tidak ditemukan.";
                 $feedback_type = 'info'; 
            }
        } catch (Exception $e) {
            $koneksi->rollback();
            $feedback_message = "Gagal mengubah status pembayaran: " . $e->getMessage();
            $feedback_type = 'error';
            error_log($feedback_message);
        }
    } else {
        $feedback_message = "Permintaan update status pembayaran tidak valid.";
        $feedback_type = 'error';
    }
    
    $filter_params = http_build_query([
        'search' => $_GET['search'] ?? '',
        'tanggal' => $_GET['tanggal'] ?? '', 
        'bayar' => $_GET['bayar'] ?? 'Semua',
        'kirim' => $_GET['kirim'] ?? 'Semua'
    ]);
    header("Location: laporanPenjualan.php?feedback=" . urlencode($feedback_message) . "&type=" . $feedback_type . "&" . $filter_params); exit;
}


